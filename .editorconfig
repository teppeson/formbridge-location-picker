root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{bat,cmd}]
end_of_line = crlf

[*.csv]
end_of_line = crlf

# Keep the Windows working tree copy consistent; repository blobs remain LF.
[formbridge-location-picker.js]
end_of_line = crlf
